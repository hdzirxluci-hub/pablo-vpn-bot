# Runtime
ENVIRONMENT=development
DEMO_MODE=true
PUBLIC_URL=https://your-app.up.railway.app
MINI_APP_URL=https://your-app.up.railway.app
DATABASE_URL=sqlite+aiosqlite:///./pablo-vpn.db

# Telegram — set only in Railway Variables
BOT_USERNAME=PablloVPN3_bot
BOT_TOKEN=
OWNER_TELEGRAM_ID=
TELEGRAM_WEBHOOK_SECRET=
INIT_DATA_MAX_AGE_SECONDS=3600

# Encrypted backup and Railway reminders
# Use a long random value; never commit the real passphrase.
BACKUP_PASSPHRASE=
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
BACKUP_WARNING_DAYS=3
# Optional ISO-8601 value. Owner can instead run /railway 30.
RAILWAY_EXPIRES_AT=

# Panel runtime: mock for local preview, real for production
PANEL_MODE=mock
PANEL_TIMEOUT_SECONDS=15
PANEL_VERIFY_TLS=true

# PasarGuard
PASARGUARD_URL=
PASARGUARD_USERNAME=
PASARGUARD_PASSWORD=
PASARGUARD_GROUP_ID=

# 3x-ui (prefer an API token; username/password is the fallback)
XUI_URL=
XUI_API_TOKEN=
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=
XUI_SUBSCRIPTION_BASE_URL=

# Marzban
MARZBAN_URL=
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
MARZBAN_PROXIES_JSON={"vless":{}}
MARZBAN_INBOUNDS_JSON={}
